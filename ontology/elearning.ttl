    :aPrerequis :Cours_StatsBase ;
    :enseignePar :Formateur_ElAmrani ;
    :faitPartieDe :Parcours_DataScientist ;
    :aDuree 20 ;
    :aNote "4.7"^^xsd:float ;
    :estGratuit false .
# Grâce à owl:inverseOf déclaré plus haut, un raisonneur déduit
# automatiquement: Cours_PythonBases estPrerequisDe Cours_IntroML

:Cours_IntroDeepLearning a owl:NamedIndividual, :Cours ;
    :aTitre "Introduction au deep learning" ;
    :aNiveau :Debutant ;
    :appartientADomaine :DeepLearning ;
    :aPrerequis :Cours_IntroML ;
    :enseigneCompetence :CompReseauxNeurones ;
    :faitPartieDe :Parcours_DataScientist ;
    :aDuree 18 ;
    :aNote "4.8"^^xsd:float ;
    :estGratuit false .

# Cas piège volontaire pour la démo : titre dit "débutant" mais
# requiert en réalité l'algèbre linéaire (prérequis caché)
:Cours_DeepLearningPyTorch a owl:NamedIndividual, :Cours ;
    :aTitre "Deep learning avancé avec PyTorch (niveau débutant)" ;
    :aNiveau :Debutant ;
    :appartientADomaine :DeepLearning ;
    :aPrerequis :Cours_AlgebreLineaire ;
    :requiertCompetence :CompAlgebreLineaire ;
    :aDuree 25 ;
    :aNote "4.4"^^xsd:float ;
    :estGratuit false .

:Cours_WebBases a owl:NamedIndividual, :Cours ;
    :aTitre "Les bases du développement web" ;
    :aNiveau :Debutant ;
    :appartientADomaine :DeveloppementWeb ;
    :enseigneCompetence :CompHTML ;
    :faitPartieDe :Parcours_DevWeb ;
    :aDuree 14 ;
    :aNote "4.5"^^xsd:float ;
    :estGratuit true .

:Cours_JSAvance a owl:NamedIndividual, :Cours ;
    :aTitre "JavaScript avancé" ;
    :aNiveau :Avance ;
    :appartientADomaine :DeveloppementWeb ;
