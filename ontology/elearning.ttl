@prefix : <http://www.projet-pfm.org/elearning#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  ONTOLOGIE E-LEARNING (version complète OWL)
#  A importer dans Protege (fichier > ouvrir > choisir ce .ttl)
#################################################################

<http://www.projet-pfm.org/elearning> a owl:Ontology ;
    rdfs:label "Ontologie E-learning pour moteur de recherche hybride" .

#################################################################
#  CLASSES
#################################################################

:Cours a owl:Class ;
    rdfs:label "Cours" ;
    rdfs:comment "Un cours en ligne proposé sur la plateforme" .

:Competence a owl:Class ;
    rdfs:label "Compétence" ;
    rdfs:comment "Une compétence enseignée ou requise par un cours" .

:Domaine a owl:Class ;
    rdfs:label "Domaine" ;
    rdfs:comment "Un domaine thématique (ex: Data Science, Web, Langues)" .

:Niveau a owl:Class ;
    rdfs:label "Niveau" ;
    rdfs:comment "Le niveau de difficulté d'un cours" .

:Formateur a owl:Class ;
    rdfs:label "Formateur" ;
    rdfs:comment "La personne ou organisme qui dispense le cours" .

:Parcours a owl:Class ;
    rdfs:label "Parcours" ;
    rdfs:comment "Une séquence ordonnée de cours menant à un objectif" .

# --- Classes disjointes ---
# On déclare explicitement qu'une instance ne peut PAS appartenir
# à deux de ces classes en même temps (ex: un Cours ne peut pas
# être aussi une Competence). C'est une contrainte logique OWL,
# pas juste une convention.
[] a owl:AllDisjointClasses ;
    owl:members ( :Cours :Competence :Domaine :Niveau :Formateur :Parcours ) .

#################################################################
#  PROPRIETES D'OBJET (relations entre instances)
#################################################################

:aPrerequis a owl:ObjectProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Cours ;
    rdfs:label "a pour prérequis" ;
    owl:inverseOf :estPrerequisDe .

:estPrerequisDe a owl:ObjectProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Cours ;
    rdfs:label "est prérequis de" ;
    rdfs:comment "Relation inverse de aPrerequis, déduite automatiquement par le raisonneur" .

:enseigneCompetence a owl:ObjectProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Competence ;
    rdfs:label "enseigne la compétence" .

:requiertCompetence a owl:ObjectProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Competence ;
    rdfs:label "requiert la compétence" ;
    rdfs:comment "Compétence nécessaire en entrée, même si non listée comme prérequis explicite" .

:appartientADomaine a owl:ObjectProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Domaine ;
    rdfs:label "appartient au domaine" .

:aNiveau a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Niveau ;
    rdfs:label "a pour niveau" ;
    rdfs:comment "FunctionalProperty: un cours a EXACTEMENT un seul niveau, jamais deux" .

:enseignePar a owl:ObjectProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Formateur ;
    rdfs:label "enseigné par" .

:faitPartieDe a owl:ObjectProperty ;
    rdfs:domain :Cours ;
    rdfs:range :Parcours ;
    rdfs:label "fait partie du parcours" .

:sousDomaineDe a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain :Domaine ;
    rdfs:range :Domaine ;
    rdfs:label "sous-domaine de" ;
    rdfs:comment "TransitiveProperty: si DeepLearning sousDomaineDe MachineLearning et MachineLearning sousDomaineDe IA, alors le raisonneur déduit automatiquement DeepLearning sousDomaineDe IA" .

#################################################################
#  PROPRIETES DE DONNEES (valeurs simples)
#################################################################

:aDuree a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cours ;
    rdfs:range xsd:integer ;
    rdfs:label "durée en heures" .

:aNote a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cours ;
    rdfs:range xsd:float ;
    rdfs:label "note moyenne" .

:estGratuit a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cours ;
    rdfs:range xsd:boolean ;
    rdfs:label "est gratuit" .

:aTitre a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Cours ;
    rdfs:range xsd:string ;
    rdfs:label "titre" .

#################################################################
#  RESTRICTIONS DE CARDINALITE SUR :Cours
#  On renforce la définition de la classe Cours avec des règles
#  logiques que doit respecter toute instance de ce type.
#################################################################

:Cours rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty :aNiveau ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty :appartientADomaine ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
# Traduction: tout Cours doit avoir EXACTEMENT 1 niveau,
# et AU MOINS 1 domaine. Un raisonneur OWL (ex: HermiT dans Protégé)
# peut vérifier automatiquement qu'aucune instance ne viole ces règles.

#################################################################
#  INSTANCES - NIVEAUX
#################################################################

:Debutant a owl:NamedIndividual, :Niveau ; rdfs:label "Débutant" .
:Intermediaire a owl:NamedIndividual, :Niveau ; rdfs:label "Intermédiaire" .
:Avance a owl:NamedIndividual, :Niveau ; rdfs:label "Avancé" .

#################################################################
#  INSTANCES - DOMAINES (avec hiérarchie transitive)
#################################################################

:Informatique a owl:NamedIndividual, :Domaine ; rdfs:label "Informatique" .

:DataScience a owl:NamedIndividual, :Domaine ;
    rdfs:label "Data Science" ;
    :sousDomaineDe :Informatique .

:IntelligenceArtificielle a owl:NamedIndividual, :Domaine ;
    rdfs:label "Intelligence Artificielle" ;
    :sousDomaineDe :DataScience .

:MachineLearning a owl:NamedIndividual, :Domaine ;
    rdfs:label "Machine Learning" ;
    :sousDomaineDe :IntelligenceArtificielle .

:DeepLearning a owl:NamedIndividual, :Domaine ;
    rdfs:label "Deep Learning" ;
    :sousDomaineDe :MachineLearning .
# Grâce à owl:TransitiveProperty déclaré plus haut, un raisonneur
# déduit automatiquement: DeepLearning sousDomaineDe Informatique
# (sans qu'on l'ait écrit explicitement)

:DeveloppementWeb a owl:NamedIndividual, :Domaine ;
    rdfs:label "Développement Web" ;
    :sousDomaineDe :Informatique .

:Mathematiques a owl:NamedIndividual, :Domaine ; rdfs:label "Mathématiques" .

:Cloud a owl:NamedIndividual, :Domaine ;
    rdfs:label "Cloud" ;
    :sousDomaineDe :Informatique .

:DevOps a owl:NamedIndividual, :Domaine ;
    rdfs:label "DevOps" ;
    :sousDomaineDe :Informatique .

:BasesDeDonnees a owl:NamedIndividual, :Domaine ;
    rdfs:label "Bases de données" ;
    :sousDomaineDe :Informatique .

:NLP a owl:NamedIndividual, :Domaine ;
    rdfs:label "Traitement du langage naturel" ;
    :sousDomaineDe :IntelligenceArtificielle .

:CyberSecurite a owl:NamedIndividual, :Domaine ;
    rdfs:label "Cybersécurité" ;
    :sousDomaineDe :Informatique .

:Langues a owl:NamedIndividual, :Domaine ; rdfs:label "Langues" .

#################################################################
#  INSTANCES - COMPETENCES
#################################################################

:CompPython a owl:NamedIndividual, :Competence ; rdfs:label "Python" .
:CompAlgebreLineaire a owl:NamedIndividual, :Competence ; rdfs:label "Algèbre linéaire" .
:CompStatistiques a owl:NamedIndividual, :Competence ; rdfs:label "Statistiques" .
:CompReseauxNeurones a owl:NamedIndividual, :Competence ; rdfs:label "Réseaux de neurones" .
:CompHTML a owl:NamedIndividual, :Competence ; rdfs:label "HTML/CSS" .
:CompJavaScript a owl:NamedIndividual, :Competence ; rdfs:label "JavaScript" .
:CompSQL a owl:NamedIndividual, :Competence ; rdfs:label "SQL" .
:CompDocker a owl:NamedIndividual, :Competence ; rdfs:label "Docker" .
:CompGit a owl:NamedIndividual, :Competence ; rdfs:label "Git" .

# --- Cas volontaire d'AMBIGUÏTÉ pour démontrer la désambiguïsation ---
# "Cloud" existe à la fois comme Domaine (thématique de cours) et comme
# Competence (savoir-faire enseigné). graph_service.link_entities_in_query()
# détecte les deux interprétations et documente la résolution retenue.
:CompCloud a owl:NamedIndividual, :Competence ; rdfs:label "Cloud" .

#################################################################
#  INSTANCES - FORMATEURS
#################################################################

:Formateur_Benali a owl:NamedIndividual, :Formateur ; rdfs:label "Aïcha Benali" .
:Formateur_ElAmrani a owl:NamedIndividual, :Formateur ; rdfs:label "Youssef El Amrani" .

#################################################################
#  INSTANCES - PARCOURS
#################################################################

:Parcours_DataScientist a owl:NamedIndividual, :Parcours ;
    rdfs:label "Parcours Data Scientist" .

:Parcours_DevWeb a owl:NamedIndividual, :Parcours ;
    rdfs:label "Parcours Développeur Web" .

#################################################################
#  INSTANCES - COURS
#################################################################

:Cours_PythonBases a owl:NamedIndividual, :Cours ;
    :aTitre "Python pour débutants" ;
    :aNiveau :Debutant ;
    :appartientADomaine :Informatique ;
    :enseigneCompetence :CompPython ;
    :enseignePar :Formateur_Benali ;
    :faitPartieDe :Parcours_DataScientist ;
    :aDuree 15 ;
    :aNote "4.6"^^xsd:float ;
    :estGratuit true .

:Cours_StatsBase a owl:NamedIndividual, :Cours ;
    :aTitre "Statistiques fondamentales" ;
    :aNiveau :Debutant ;
    :appartientADomaine :Mathematiques ;
