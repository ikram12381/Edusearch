    :faitPartieDe :Parcours_DataScientist ;
    :aDuree 10 ;
    :aNote "4.3"^^xsd:float ;
    :estGratuit true .

:Cours_AlgebreLineaire a owl:NamedIndividual, :Cours ;
    :aTitre "Algèbre linéaire appliquée" ;
    :aNiveau :Intermediaire ;
    :appartientADomaine :Mathematiques ;
    :enseigneCompetence :CompAlgebreLineaire ;
    :aDuree 12 ;
    :aNote "4.1"^^xsd:float ;
    :estGratuit false .

:Cours_IntroML a owl:NamedIndividual, :Cours ;
    :aTitre "Introduction au Machine Learning" ;
    :aNiveau :Debutant ;
    :appartientADomaine :MachineLearning ;
